# Copiá este archivo a `.env` y completá los valores reales.
# `.env` nunca se sube al repositorio (.gitignore).

# Puerto en el que escucha el servidor local.
PORT=3001

# Cadena de conexión a MongoDB (Atlas o local). 
# OBLIGATORIA: el servidor no arranca sin ella.
MONGODB_CNN=mongodb+srv://usuario:password@cluster.mongodb.net/ventock

# Clave secreta para firmar y verificar los tokens JWT (login).
# OBLIGATORIA: el servidor no arranca sin ella. Tiene que ser un valor largo y aleatorio.
SECRETORPRIVATEKEY=reemplazar_por_una_clave_secreta_larga_y_aleatoria
